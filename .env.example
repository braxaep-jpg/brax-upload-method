# Backend Configuration
PORT=4000
NODE_ENV=development

# FFmpeg Paths (optional, if not in system PATH)
FFMPEG_PATH=
FFPROBE_PATH=

# Frontend API URL. Leave empty when the backend serves the frontend from the same origin.
VITE_API_BASE_URL=
VITE_API_URL=
# Frontend site URL
VITE_SITE_URL=https://tiktokvideooptimizer.com

# Optional: Database or Cloud Storage
# AWS_S3_BUCKET=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
